@"
# Environment & secrets (Azure SQL connection strings, API keys)
.env
*.env
local.settings.json

# Python virtual environments & cache
venv/
.venv/
__pycache__/
*.pyc

# Node modules (if using JS/TS)
node_modules/

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
"@ | Set-Content -Path .gitignore -Encoding UTF8